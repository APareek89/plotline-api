# Copy your key line here yourself (from ~/Documents/Handson/.env) — never paste it in chat.
ANTHROPIC_API_KEY=
# 1 = deterministic mock agents (no key needed); 0 = real Claude calls
MOCK_LLM=1

# --- retrieval (plotline-rag frozen contract) --------------------------------
# Real service (Codex's plotline-rag). Contract default port is 8787; locally
# it runs on 8788 while devrag still holds 8787:
#   cd ~/Documents/plotline-rag && make serve-s3 PORT=8788
PLOTLINE_RAG_URL=http://127.0.0.1:8788
PLOTLINE_RAG_TIMEOUT_SECONDS=10
PLOTLINE_RAG_ENABLED=1
# devrag keeps serving asset:/stat:/trend: sample corpora until plotline-kb lands:
#   uvicorn devrag.server:app --port 8787
PLOTLINE_AUX_RAG_URL=http://127.0.0.1:8787
# The AWS corpus currently holds 10 dev-only tier="seed" chunks. Seed evidence
# is REJECTED by default (production-safe); set 1 for local integration only.
PLOTLINE_ALLOW_SEED_EVIDENCE=0

# --- media generation --------------------------------------------------------
# 1 = deterministic placeholder assets at ZERO cost; the whole interaction
# contract (cost lines, accept/re-roll, gates) still runs. Set 0 to spend.
MOCK_MEDIA=1
# Which provider is tried FIRST. The other is the fallback, reached only when
# the first fails on transport or provider error — never on a policy refusal,
# because a declined prompt is a real answer and re-asking costs money to hear
# it twice. Suffix _only ("pixelbin_only") disables the fallback.
PLOTLINE_MEDIA_PROVIDER=pixelbin
# PixelBin — console.pixelbin.io → API Tokens. Cloud name is on the same page.
PIXELBIN_API_TOKEN=
PIXELBIN_CLOUD_NAME=
# fal.ai — the fallback. Leave blank to run PixelBin with no safety net.
FAL_KEY=

# --- web search enrichment ---------------------------------------------------
# Anthropic's native server-side web_search tool. No extra key: it bills to the
# same ANTHROPIC_API_KEY (~$10/1000 searches on top of tokens). 0 disables it,
# and the brief is simply less enriched — never silently faked.
PLOTLINE_WEB_SEARCH=1
PLOTLINE_WEB_SEARCH_MAX_USES=3

# --- per-stage models (operator knob; NOT exposed in the product) ------------
# Each stage falls through to the broad slot above unless set, so leaving these
# blank changes nothing. Cheap stages are mechanical (lint a board, name four
# canon views); the expensive ones are the stages that argue.
#   PLOTLINE_MODEL_INTAKE=   PLOTLINE_MODEL_BRIEF=    PLOTLINE_MODEL_OPTIONS=
#   PLOTLINE_MODEL_DETAIL=   PLOTLINE_MODEL_SCRIPT=   PLOTLINE_MODEL_BOARD=
#   PLOTLINE_MODEL_CANON=    PLOTLINE_MODEL_COUNCIL=
